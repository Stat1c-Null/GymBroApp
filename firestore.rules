// Firestore security rules for gymbroapp-7b680.
//
// These live here, in the repo, so they can no longer drift out of step with
// the client. That drift is exactly what broke the friend body-weight panel:
// the friend-read rule for `weeks/*/entries` shipped with the "see a friend's
// week" feature, but the matching rule for `weights` was only ever written up
// in the wiki and never applied to the project — so `WeightService.recentFor()`
// was refused for every uid but your own.
//
// Deploy with:  firebase deploy --only firestore:rules
// (or paste this file into Firebase console -> Firestore -> Rules -> Publish)
//
// See `.claude/wiki/database.md` -> "Reading a friend's data" for the design.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sorted-pair friendship id, matching friendshipId() in services/friends.ts.
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // Is the signed-in user an *accepted* friend of otherUid? exists() first:
    // get() on a missing document yields null, and reading .data off it fails.
    function isAcceptedFriend(otherUid) {
      let path = /databases/$(database)/documents/friendships/$(pairId(request.auth.uid, otherUid));
      return exists(path) && get(path).data.status == 'accepted';
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // A friend's logged week — read-only. Rules are OR-ed with the owner rule
    // above, so this only ever adds access.
    match /users/{userId}/weeks/{weekId}/entries/{entryId} {
      allow read: if request.auth != null && isAcceptedFriend(userId);
    }

    // A friend's body-weight log — read-only. Backs FriendWeightComponent;
    // without this the panel can only ever render its "couldn't load" state.
    match /users/{userId}/weights/{entryId} {
      allow read: if request.auth != null && isAcceptedFriend(userId);
    }

    // Owner-scoped collection-group read, for the cross-week exercise analytics
    // query. Needs the `uid` field stamped on every entry (WeekService.add /
    // update, plus EntryBackfillService for older docs).
    match /{path=**}/entries/{entryId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Any signed-in user can read any profile — the deliberate price of search.
    match /userProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /friendships/{pairId} {
      allow read:   if request.auth != null
                    && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.requesterUid
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 2
                    && request.resource.data.status == 'pending';
      // Only the recipient can accept, and only pending -> accepted. Because a
      // setDoc onto an existing document counts as an update, this also refuses
      // to re-open an already-accepted friendship as pending.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members
                    && request.auth.uid != resource.data.requesterUid
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.members == resource.data.members;
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.members;
    }
  }
}
