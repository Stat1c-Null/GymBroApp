// Firestore security rules for gymbroapp-7b680.
//
// These live here, in the repo, so they can no longer drift out of step with
// the client. That drift is exactly what broke the friend body-weight panel:
// the friend-read rule for `weeks/*/entries` shipped with the "see a friend's
// week" feature, but the matching rule for `weights` was only ever written up
// in the wiki and never applied to the project — so `WeightService.recentFor()`
// was refused for every uid but your own.
//
// Deploy with:  firebase deploy --only firestore:rules
// (or paste this file into Firebase console -> Firestore -> Rules -> Publish)
//
// See `.claude/wiki/database.md` -> "Reading a friend's data" for the design.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sorted-pair friendship id, matching friendshipId() in services/friends.ts.
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // Is the signed-in user an *accepted* friend of otherUid? exists() first:
    // get() on a missing document yields null, and reading .data off it fails.
    //
    // The membership checks are not redundant with the document id: they are
    // what stops a friendship document from vouching for anyone but the two
    // people actually in it, even if one were ever written under a forged id.
    function isAcceptedFriend(otherUid) {
      let path = /databases/$(database)/documents/friendships/$(pairId(request.auth.uid, otherUid));
      return exists(path) && isAcceptedPair(get(path).data, otherUid);
    }

    function isAcceptedPair(friendship, otherUid) {
      return friendship.status == 'accepted'
          && request.auth.uid in friendship.members
          && otherUid in friendship.members;
    }

    // A document under users/{userId} may carry a `uid` field only if it is the
    // owner's. Week entries denormalize `uid` for the collection-group analytics
    // read below; without this, anyone could stamp an entry in their *own* tree
    // with someone else's uid and have it appear in that person's analytics.
    function stampsOnlyOwner(userId) {
      return !('uid' in request.resource.data) || request.resource.data.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
                            && stampsOnlyOwner(userId);
    }

    // A friend's logged week — read-only. Rules are OR-ed with the owner rule
    // above, so this only ever adds access.
    match /users/{userId}/weeks/{weekId}/entries/{entryId} {
      allow read: if request.auth != null && isAcceptedFriend(userId);
    }

    // A friend's body-weight log — read-only. Backs FriendWeightComponent;
    // without this the panel can only ever render its "couldn't load" state.
    match /users/{userId}/weights/{entryId} {
      allow read: if request.auth != null && isAcceptedFriend(userId);
    }

    // Owner-scoped collection-group read, for the cross-week exercise analytics
    // query. Needs the `uid` field stamped on every entry (WeekService.add /
    // update, plus EntryBackfillService for older docs).
    match /{path=**}/entries/{entryId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Any signed-in user can read any profile — the deliberate price of search.
    // Because of that, a profile holds only what is safe to show everyone: the
    // email address is NOT allowed here (see emailIndex below). Rules cannot hide
    // a field from a read, so the only way to keep it private is to never store it.
    match /userProfiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.uid == uid
                            && request.resource.data.keys().hasOnly(
                                 ['uid', 'displayName', 'displayNameLower', 'createdAt', 'updatedAt']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Exact-email lookup: emailIndex/{lowercased email} -> { uid }.
    //  - `get` only, never `list`: you can find the owner of an address you
    //    already know, but you cannot page through everyone's addresses.
    //  - Writable only for the address on the caller's own Firebase Auth token,
    //    so nobody can claim someone else's email to be found in their place.
    match /emailIndex/{email} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
                            && request.auth.token.email != null
                            && email == request.auth.token.email.lower()
                            && request.resource.data.keys().hasOnly(['uid'])
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /friendships/{friendshipId} {
      allow read:   if request.auth != null
                    && request.auth.uid in resource.data.members;
      // The id must be the sorted pair of the two members. Without that check a
      // user could create friendships/{pairId(self, victim)} listing a second
      // account of their own as the other member, accept it from that account,
      // and isAcceptedFriend(victim) would then let them read the victim's data.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.requesterUid
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 2
                    && request.resource.data.members[0] != request.resource.data.members[1]
                    && friendshipId == pairId(request.resource.data.members[0],
                                              request.resource.data.members[1])
                    && request.resource.data.status == 'pending';
      // Only the recipient can accept, and only pending -> accepted. Because a
      // setDoc onto an existing document counts as an update, this also refuses
      // to re-open an already-accepted friendship as pending.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members
                    && request.auth.uid != resource.data.requesterUid
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.members == resource.data.members;
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.members;
    }
  }
}
