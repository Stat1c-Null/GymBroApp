# ===== База данных =====
POSTGRES_PASSWORD=your_strong_postgres_password_here

# ===== JWT (минимум 32 байта = 43 символа в base64) =====
# Сгенерируй: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_at_least_32_bytes_base64_here

# ===== CORS (фронтенд) =====
CORS_ORIGINS=http://localhost:4200
